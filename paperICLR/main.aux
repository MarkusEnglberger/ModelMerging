\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The accuracy--retention trade-off of Table\nobreakspace  {}\ref  {tab:clip20heldout}: models built from the $14$ training tasks, evaluated on them ($x$) and zero-shot on the $6$ held-out tasks ($y$; dotted line: the base model). The frontier's high-accuracy half is populated entirely by the anchored refinement; every merge (gray squares) is dominated, and the ungated learning-rate arc (triangles) bends away from it.\relax }}{11}{table.caption.20}\protected@file@percent }
\newlabel{fig:clip20heldout}{{1}{11}{The accuracy--retention trade-off of Table~\ref {tab:clip20heldout}: models built from the $14$ training tasks, evaluated on them ($x$) and zero-shot on the $6$ held-out tasks ($y$; dotted line: the base model). The frontier's high-accuracy half is populated entirely by the anchored refinement; every merge (gray squares) is dominated, and the ungated learning-rate arc (triangles) bends away from it.\relax }{table.caption.20}{}}
