\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Eight-task CLIP ViT-B/32 suite (single seed, $n=64$, $S=5$, $\gamma =1$, uniform $\lambda _i=0.3$). Best learning rate per family by mean normalized retention (Eq.~\eqref  {eq:normalized-retention}); worst-task retention in parentheses. The gated update is best on both, and is the only method keeping worst-task retention positive.}}{14}{table.3}\protected@file@percent }
\newlabel{tab:clip8}{{3}{14}{Eight-task CLIP ViT-B/32 suite (single seed, $n=64$, $S=5$, $\gamma =1$, uniform $\lambda _i=0.3$). Best learning rate per family by mean normalized retention (Eq.~\eqref {eq:normalized-retention}); worst-task retention in parentheses. The gated update is best on both, and is the only method keeping worst-task retention positive}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-task top-1 accuracy on the eight-task CLIP suite: zero-shot backbone, task expert, task-arithmetic merge, and the proposed gated refinement (APR, $\eta =8$). Refinement recovers most of the merge's interference loss, including on Cars and SUN397, which the merge had degraded below the zero-shot backbone.}}{14}{table.4}\protected@file@percent }
\newlabel{tab:clip8pt}{{4}{14}{Per-task top-1 accuracy on the eight-task CLIP suite: zero-shot backbone, task expert, task-arithmetic merge, and the proposed gated refinement (APR, $\eta =8$). Refinement recovers most of the merge's interference loss, including on Cars and SUN397, which the merge had degraded below the zero-shot backbone}{table.4}{}}
