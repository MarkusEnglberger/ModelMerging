.venv
.venv/
.hf_cache
.hf_cache/
.mats_data/
__pycache__/
*.pyc
# Experiment outputs are large -- the merge cache alone holds 351 MB model
# states and results/ totals several GB. The compare/ summaries are different:
# a few MB of JSON that are the provenance for every number in the paper, so
# they are versioned and everything else is not.
results/*
!results/compare/
results/compare/*
!results/compare/*.json
logs/
experts/

# SSH keys — never commit
key.txt
key.txt.pub
*.pem
id_ed25519*
id_rsa*

# Editor / assistant local config
.vscode/
.claude/

# LaTeX build artifacts (main.pdf and main.bbl are versioned deliberately:
# the PDF is the shared artifact, the .bbl its bibliography provenance)
*.aux
*.log
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# Editor backups and patch leftovers
*.bak*
*.orig
*~
